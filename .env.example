# ==============================================================================
# University Ranking Analytics Platform - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Primary PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=university_ranking_db
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/university_ranking_db

# Read-Only Database User (enforces SQL safety at DB permission level for GenAI)
POSTGRES_READONLY_USER=ranking_readonly
POSTGRES_READONLY_PASSWORD=your_readonly_password_here
READONLY_DATABASE_URL=postgresql+psycopg2://ranking_readonly:your_readonly_password_here@localhost:5432/university_ranking_db

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# LangSmith Observability & Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=university-ranking-analytics

# Application Settings
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
